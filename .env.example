# Copy to .env.local and fill in (Vite reads VITE_* at build time)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local dev only: base URL where /api/contact exists (your Vercel preview or production URL).
# Plain `npm run dev` does not run serverless functions; use this or `npm run dev:vercel`.
# VITE_CONTACT_API_ORIGIN=https://your-project.vercel.app

# --- Server-only (set in Vercel → Settings → Environment Variables, NOT prefixed with VITE_)
# Used by api/contact.js (Resend or Nodemailer). Never expose secrets to the browser.
#
# Preferred: Resend (https://resend.com)
#   RESEND_API_KEY=...
#   RESEND_FROM="Burhani Traders <onboarding@resend.dev>"   # or your verified domain sender
#   CONTACT_TO=burhanitradersctg@gmail.com
#
# Free SMTP example: Brevo (brevo.com) → SMTP & API → create SMTP key.
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your Brevo SMTP login
#   SMTP_PASS=your Brevo SMTP password
#   CONTACT_TO=inbox@yourdomain.com
#
# RESEND_API_KEY=
# RESEND_FROM=
# RESEND_TO=
#
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO=
# CONTACT_FROM=
# CONTACT_SITE_NAME=Burhani Traders
