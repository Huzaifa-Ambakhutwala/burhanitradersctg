rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'approved'];
    }

    match /product-images/{productId}/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /category-images/{categoryId}/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /hero-images/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
